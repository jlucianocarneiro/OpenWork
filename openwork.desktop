[Desktop Entry]
Name=OpenWork
Comment=Assistente IA local com Ollama
Exec=bash -c 'cd $HOME/OpenWork && source .venv/bin/activate && python3 openwork.py --web & sleep 2 && xdg-open http://localhost:8787'
Icon=$HOME/OpenWork/assets/openwork-icon-256.png
Terminal=false
Type=Application
Categories=Utility;Development;
StartupNotify=true
StartupWMClass=OpenWork
